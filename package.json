{
  "name": "dsh-fail-guard",
  "version": "1.0.0",
  "description": "Standalone DeepSeek Harness guard for repeated tool failures and repetitive reasoning.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "REFERENCES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FenrirCait/dsh-fail-guard.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "loop-guard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "react": "^18.2.0"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  }
}
